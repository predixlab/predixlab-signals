# Full historical Collector tree used to build training datasets.
PREDIXLAB_TRAINING_DATA=data

# Clean production tree used for inference input, production models, and daily
# predictions/picks CSV files.
PREDIXLAB_DATA=~/.predixlab

# Rebuildable research artifacts: datasets, walk-forward predictions, reports, and candidate models from train.
PIVOT_ARTIFACTS=artifacts

# Daily job
PIVOT_MARKET=us
PIVOT_HORIZON=10
PIVOT_TAG=default
ALPHARANK_TAG=default
PIVOT_LOOKBACK=250
PIVOT_MAX_PER_SIDE=0
PIVOT_REQUIRE_TRADING_DAY=true
# Combined fraction of missing, invalid, unchanged, or unusable constituents.
PIVOT_DATA_MAX_BAD_RATIO=0.05

# MongoDB; pivot_picks is separate from other signal collections.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=predixlab
PIVOT_PICKS_COLLECTION=pivot_picks
ALPHARANK_COLLECTION=alpharank
ALPHARANK_GENERATIONS_COLLECTION=alpharank_generations
ALPHARANK_TOP_N=15
JOBS_COLLECTION=jobs

# Optional Azure Communication Services Email. Messages are sent only when all three values are configured.
ACS_CONNECTION_STRING="endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key"
ACS_SENDER_EMAIL=DoNotReply@your-domain.com
ACS_TO_EMAILS=user1@example.com,user2@example.com
